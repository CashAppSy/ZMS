rules_version = '2';
// ============================================================
// ZMS Firestore Security Rules (hardened) — round 4, per-record.
//
// WHAT CHANGED vs round 3 (the single-document model):
//   Projects and tasks no longer live in ONE whole-dataset doc
//   per collection (zms_projects/data, zms_tasks/data) which could
//   only be authorized as "manager/admin or nothing". They are now
//   stored PER RECORD (zms_projects/{projId}, zms_tasks/{taskId})
//   so authorization can be checked per document (ZMS-RT-05/06):
//     - the manager of a project (project.managerId == caller's
//       personId) may create/update THAT project and ANY task that
//       belongs to it;
//     - the assignees of a task (caller's personId in assignees)
//       may change ONLY the status of THAT task (status, progress,
//       activity, updatedAt — the exact fields the status UI writes);
//     - everything else on tasks/projects stays admin-only;
//     - a task may be CREATED by a manager in ANY pillar (auth.js
//       canCreateTask: an unassigned task belongs to nobody);
//     - DELETING a task/pillar/meeting is admin-only OR the manager who
//       CREATED that record (canDeleteRecord). Being able to create a task
//       in a pillar you do not manage does not let you destroy it.
//   The global activity log (zms_activities, round 6) is an append-only
//   per-record collection: any ACTIVE team member may create an entry,
//   everyone may read, only admins may delete (clearing the log).
//   MEETINGS are per record too (zms_meetings/<meetingId>), written by admins
//   and managers (the roles that may create/edit a meeting) and deleted by an
//   admin or the manager who created that meeting. They were added because the
//   app was storing them per-device
//   in localStorage, which meant a meeting never reached any other user.
//   The other collections (departments, people, statuses,
//   priorities, custom field defs, saved filters) stay in the
//   whole-document model where members are read-only and managers
//   (or the bootstrap-owner migration guard) may push.
//
//   personId is the join key: it must equal the person record id
//   (people.id) that the manager/assignee selection stores. The
//   client writes it into zms_auth_users/{uid}.personId from
//   Settings -> Accounts -> Link to a person (setCloudPersonId) or
//   at sign-up. Rules treat a missing personId as null, so a
//   profile without a linked person can never act as a manager or
//   assignee (only admins get blanket access).
//
// DEPLOY: firebase deploy --only firestore:rules
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function hasCloudProfile(uid) {
      return exists(/databases/$(database)/documents/zms_auth_users/$(uid));
    }

    function isActiveUser(uid) {
      // a missing `active` field is treated as active (legacy records).
      // Rules are NOT null-safe: `get(...).data.active` on a doc WITHOUT that
      // field throws at runtime and the rule evaluates to DENIED. Guard every
      // field read with the `in` operator.
      return hasCloudProfile(uid)
        && ('active' in get(/databases/$(database)/documents/zms_auth_users/$(uid)).data
            ? get(/databases/$(database)/documents/zms_auth_users/$(uid)).data.active == true
            : true);
    }

    function isTeamMember(uid) {
      return hasCloudProfile(uid);
    }

    function hasRole(uid, role) {
      return hasCloudProfile(uid)
        && get(/databases/$(database)/documents/zms_auth_users/$(uid)).data.role == role;
    }

    function isAdmin(uid) {
      return isActiveUser(uid) && hasRole(uid, 'admin');
    }

    function isManagerOrAdmin(uid) {
      return isActiveUser(uid) && (hasRole(uid, 'manager') || hasRole(uid, 'admin'));
    }

    // True when this uid is the account recorded as the very first cloud
    // account (zms_auth/bootstrap.firstUid). Grants dataset WRITE access to
    // pre-role deployments; never grants account management.
    function isBootstrapOwner(uid) {
      return isActiveUser(uid)
        && exists(/databases/$(database)/documents/zms_auth/bootstrap)
        && get(/databases/$(database)/documents/zms_auth/bootstrap).data.firstUid == uid;
    }

    // The bootstrap marker has to be readable during signup, BEFORE the new
    // account's own zms_auth_users record exists, so it must not be gated on
    // isActiveUser(). It is not sensitive (records no secrets).
    function signupCanRead() {
      return request.auth != null;
    }

    // whole-dataset write: active manager/admin, or the bootstrap-owner
    // migration guard (pre-role first account)
    function canWriteDataset(uid) {
      return isManagerOrAdmin(uid) || isBootstrapOwner(uid);
    }

    // ---------------- per-record helpers (round 4) ----------------

    // The personId of the CURRENT caller, read from their own cloud profile
    // (reading your own profile is always allowed). Missing => null, and a
    // null personId can never match managerId/assignees.
    function myPersonId() {
      return 'personId' in get(/databases/$(database)/documents/zms_auth_users/$(request.auth.uid)).data
        ? get(/databases/$(database)/documents/zms_auth_users/$(request.auth.uid)).data.personId
        : null;
    }

    // Is `uid` the active manager of project `projId` (by person match)?
    function isProjectManagerOf(uid, projId) {
      return projId != null
        && isActiveUser(uid)
        && exists(/databases/$(database)/documents/zms_projects/$(projId))
        && 'managerId' in get(/databases/$(database)/documents/zms_projects/$(projId)).data
        && get(/databases/$(database)/documents/zms_projects/$(projId)).data.managerId == myPersonId();
    }

    // Did the caller create `docData`? creatorOf is the resolved creator
    // personId, or null when the record was never attributed to a person.
    // Returns null for "unknown", because a caller with no linked person must
    // not match an unattributed record.
    function creatorOf(docData) {
      return docData != null && 'createdByPersonId' in docData
        ? docData.createdByPersonId
        : null;
    }
    function isCreatorOf(uid, docData) {
      return isActiveUser(uid)
        && myPersonId() != null
        && creatorOf(docData) == myPersonId();
    }

    // Deletion. An admin may delete anything. A MANAGER may delete only a record
    // they created themselves — mirrored by auth.js canDeleteRecord(). A member
    // may never delete. This is deliberately narrower than write access: being
    // able to create a task in a pillar you do not manage does not let you
    // destroy that pillar's manager's data.
    function canDeleteRecord(uid, docData) {
      return isAdmin(uid) || (isManagerOrAdmin(uid) && isCreatorOf(uid, docData));
    }

    // A task can be fully managed when its project is managed by `uid`.
    function isTaskProjectManaged(uid, taskData) {
      return isActiveUser(uid)
        && 'projectId' in taskData
        && isProjectManagerOf(uid, taskData.projectId);
    }

    // CREATING a task is deliberately WIDER than managing one. auth.js
    // canCreateTask lets an admin or a manager create a task in ANY pillar:
    // an unassigned task belongs to nobody, so it has to be reachable from
    // every pillar. Requiring the caller to manage the target pillar made
    // canCreateTask and these rules disagree, and the client's push then
    // silently skipped the record — it never reached the cloud, and the next
    // pull deleted the local copy as if a remote writer had removed it.
    // Editing stays narrower: whoever created it in a foreign pillar does not
    // thereby gain the right to rewrite it (that remains the pillar manager's
    // or an admin's).
    function canCreateTask(uid) {
      return isManagerOrAdmin(uid);
    }

    // Is the caller one of the ASSIGNEES of task `taskId`?
    function isTaskAssigneeOf(uid, taskId) {
      return isActiveUser(uid)
        && myPersonId() != null
        && exists(/databases/$(database)/documents/zms_tasks/$(taskId))
        && 'assignees' in get(/databases/$(database)/documents/zms_tasks/$(taskId)).data
        && myPersonId() in get(/databases/$(database)/documents/zms_tasks/$(taskId)).data.assignees;
    }

    // An assignee may change the STATUS of a task, which the status UI writes
    // as exactly: status, progress, activity(log) and updatedAt. Everything
    // else is off-limits for assignees (no title/dates/assignees edits).
    function isStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        ['status', 'progress', 'activity', 'updatedAt']);
    }

    // An active user may bump ONLY the shared clock (zms_meta/*.updatedAt) so
    // their status change reaches other devices, without faking
    // schemaVersion/hasData/writer fields.
    function isClockOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
    }

    // ---- per-record: projects ----
    // read        : any ACTIVE team member
    // create      : admin, or a manager creating a project they manage
    //               (managerId == their own personId)
    // update      : admin, or the CURRENT project manager (existing managerId
    //               == their personId)
    // delete      : admin only
    match /zms_projects/{projId} {
      allow read: if isTeamMember(request.auth.uid) && isActiveUser(request.auth.uid);
      allow create: if isAdmin(request.auth.uid)
        || (isManagerOrAdmin(request.auth.uid)
            && 'managerId' in request.resource.data
            && request.resource.data.managerId == myPersonId());
      allow update: if isAdmin(request.auth.uid)
        || isProjectManagerOf(request.auth.uid, projId);
      allow delete: if canDeleteRecord(request.auth.uid, resource.data);
    }

    // ---- per-record: tasks ----
    // read        : any ACTIVE team member
    // create      : an admin or a manager, in ANY pillar (canCreateTask)
    // update      : admin, or the manager of the task's project (full edit),
    //               or an ASSIGNEE changing ONLY the status of that task
    // delete      : admin only
    match /zms_tasks/{taskId} {
      allow read: if isTeamMember(request.auth.uid) && isActiveUser(request.auth.uid);
      allow create: if canCreateTask(request.auth.uid);
      allow update: if isAdmin(request.auth.uid)
        || isTaskProjectManaged(request.auth.uid, resource.data)
        || (isTaskAssigneeOf(request.auth.uid, taskId) && isStatusOnlyUpdate());
      allow delete: if canDeleteRecord(request.auth.uid, resource.data);
    }

    // ---- per-record: meetings ----
    // The client stores meetings PER RECORD (zms_meetings/<meetingId>). They
    // were previously never pushed at all, so the app kept them in one
    // browser's localStorage only and no other user could ever see them.
    // read        : any ACTIVE team member — same as tasks/projects. The
    //               attendee/creator scope is a READ-SIDE UI policy enforced in
    //               the single read path (PMS.auth.canViewMeeting), exactly
    //               like tasks; it is not a write-level restriction.
    // create/update : admin or manager, mirroring auth.js canCreateMeeting /
    //               canEditMeeting. Members are read-only for meetings.
    // delete      : an admin, or a manager who created this meeting
    //               (canDeleteRecord, same as tasks/projects).
    match /zms_meetings/{meetingId} {
      allow read: if isTeamMember(request.auth.uid) && isActiveUser(request.auth.uid);
      allow create: if isManagerOrAdmin(request.auth.uid);
      allow update: if isManagerOrAdmin(request.auth.uid);
      allow delete: if canDeleteRecord(request.auth.uid, resource.data);
    }

    // ---- append-only global activity log (round 6) ----
    // read  : any ACTIVE team member (the admin review screen reads it)
    // create: any ACTIVE team member (everyone who performs an action records
    //         their own entry; entries are immutable once created)
    // update: never — append-only, no field edits
    // delete: admin only (clearing the log)
    match /zms_activities/{id} {
      allow read: if isTeamMember(request.auth.uid) && isActiveUser(request.auth.uid);
      allow create: if isActiveUser(request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin(request.auth.uid);
    }

    // ---- shared datasets (whole-document model, unchanged) ----
    // read  : any ACTIVE team member
    // create/update : ACTIVE manager or admin (or bootstrap owner)
    // delete : admin only
    match /zms_departments/data {
      allow read: if isTeamMember(request.auth.uid) && isActiveUser(request.auth.uid);
      allow create, update: if canWriteDataset(request.auth.uid);
      allow delete: if isAdmin(request.auth.uid);
    }
    match /zms_people/data {
      allow read: if isTeamMember(request.auth.uid) && isActiveUser(request.auth.uid);
      allow create, update: if canWriteDataset(request.auth.uid);
      allow delete: if isAdmin(request.auth.uid);
    }
    match /zms_taskStatuses/data {
      allow read: if isTeamMember(request.auth.uid) && isActiveUser(request.auth.uid);
      allow create, update: if canWriteDataset(request.auth.uid);
      allow delete: if isAdmin(request.auth.uid);
    }
    match /zms_projectStatuses/data {
      allow read: if isTeamMember(request.auth.uid) && isActiveUser(request.auth.uid);
      allow create, update: if canWriteDataset(request.auth.uid);
      allow delete: if isAdmin(request.auth.uid);
    }
    match /zms_priorities/data {
      allow read: if isTeamMember(request.auth.uid) && isActiveUser(request.auth.uid);
      allow create, update: if canWriteDataset(request.auth.uid);
      allow delete: if isAdmin(request.auth.uid);
    }
    match /zms_customFieldDefs/data {
      allow read: if isTeamMember(request.auth.uid) && isActiveUser(request.auth.uid);
      allow create, update: if canWriteDataset(request.auth.uid);
      allow delete: if isAdmin(request.auth.uid);
    }
    match /zms_savedFilters/data {
      allow read: if isTeamMember(request.auth.uid) && isActiveUser(request.auth.uid);
      allow create, update: if canWriteDataset(request.auth.uid);
      allow delete: if isAdmin(request.auth.uid);
    }

    // ---- TEMP diagnostic (kept for live rule verification) ----
    match /zms_diag/auth {
      allow read: if request.auth != null;
    }
    match /zms_diag/get {
      allow read: if get(/databases/$(database)/documents/zms_auth_users/$(request.auth.uid)).data.role == 'admin';
    }
    match /zms_diag/exists {
      allow read: if exists(/databases/$(database)/documents/zms_auth_users/$(request.auth.uid));
    }
    match /zms_diag/active {
      allow read: if get(/databases/$(database)/documents/zms_auth_users/$(request.auth.uid)).data.active != false;
    }
    match /zms_diag/activeNeg {
      allow read: if !(get(/databases/$(database)/documents/zms_auth_users/$(request.auth.uid)).data.active == false);
    }
    match /zms_diag/activeIn {
      allow read: if 'active' in get(/databases/$(database)/documents/zms_auth_users/$(request.auth.uid)).data
        ? get(/databases/$(database)/documents/zms_auth_users/$(request.auth.uid)).data.active == true
        : true;
    }
    match /zms_diag/hasrole {
      allow read: if hasRole(request.auth.uid, 'admin');
    }

    // ---- sync metadata (state + probe): readable by every active user;
    //      writable by managers/admins, but an active user may update only
    //      the clock (updatedAt) so their status change propagates ----
    match /zms_meta/{doc} {
      allow read: if isActiveUser(request.auth.uid);
      allow create: if canWriteDataset(request.auth.uid);
      allow update: if canWriteDataset(request.auth.uid)
        || (isActiveUser(request.auth.uid) && isClockOnlyUpdate());
      allow delete: if false;
    }

    // ---- bootstrap marker: records the first admin ----
    match /zms_auth/bootstrap {
      // must be readable during signup, before the new account's own record
      // exists (that is what the signup flow reads to detect no-admin mode)
      allow read: if signupCanRead();
      // created once, only while it does not exist yet
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/zms_auth/bootstrap)
        && request.resource.data.firstUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/zms_auth_users/$(request.auth.uid)).data.role == 'admin';
      allow update: if isAdmin(request.auth.uid);
      allow delete: if false;
    }

    // ---- shared backups (zms_backups) ----
    // Snapshots used to live in localStorage only, so each device had a
    // private history, clearing the browser erased it, and a new device
    // inherited nothing. One shared, admin-only history is kept here.
    // read   : admin only (a snapshot contains the whole dataset)
    // create : admin only
    // update : admin only (retention prune re-writes nothing; kept for a
    //          future re-snapshot rather than silently forbidding it)
    // delete : admin only (deleting a snapshot is destructive)
    match /zms_backups/{id} {
      allow read: if isAdmin(request.auth.uid);
      allow create, update: if isAdmin(request.auth.uid);
      allow delete: if isAdmin(request.auth.uid);
    }

    // ---- account audit trail ----
    // Written DIRECTLY by the client (never through PMS.store, so the local
    // `activities` array cannot carry these): an account lives in Firebase
    // Auth and no account change passes through the synced datasets. Without
    // this collection an admin cannot see who created, demoted, disabled or
    // deleted an account, or who failed to sign in.
    // read  : ADMIN ONLY — these entries name accounts, roles and failed
    //         sign-in attempts, which no member should be able to enumerate.
    // create: any ACTIVE user, because a user records their OWN sign-in /
    //         sign-out / password-reset even with no elevated rights.
    // update: never (append-only, exactly like zms_activities)
    // delete: admin only (clearing the log)
    match /zms_account_events/{id} {
      allow read: if isAdmin(request.auth.uid);
      allow create: if isActiveUser(request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin(request.auth.uid);
    }

    // ---- cloud account directory ----
    match /zms_auth_users/{uid} {
      // privacy: a user may read their OWN profile; only admins may read the
      // directory (ZMS-RT-04). Signup reads bootstrap, not other profiles.
      allow read: if request.auth.uid == uid || isAdmin(request.auth.uid);

      // A signup write may carry role "member" — OR "admin" only while the
      // bootstrap marker is missing (the very first account). No client input
      // can mint an elevated role for a later account; promotion afterwards
      // is an admin update / the adminSetRole callable.
      allow create: if request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'role', 'displayName', 'personId', 'createdAt', 'active'])
        && (!('active' in request.resource.data) || request.resource.data.active == true)
        && ((request.resource.data.role == 'member'
             && (!('personId' in request.resource.data) || request.resource.data.personId == null))
            || (request.resource.data.role == 'admin'
                && !exists(/databases/$(database)/documents/zms_auth/bootstrap)
                && getAfter(/databases/$(database)/documents/zms_auth/bootstrap).data.firstUid == uid));

      // Authorization fields, including personId and active, are admin-only.
      // Self-service is restricted to a display name on an active profile.
      allow update: if isAdmin(request.auth.uid)
        || (request.auth.uid == uid
            && isActiveUser(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));

      // deleting an account is reserved for an admin
      allow delete: if isAdmin(request.auth.uid);
    }
  }
}
